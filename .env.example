# 数据库配置
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/quant_db

# Redis配置
REDIS_URL=redis://localhost:6379/0

# TQSDK配置
TQSDK_ACCOUNT=your_tqsdk_account_id
TQSDK_PASSWORD=your_tqsdk_password
TQSDK_SIM=true

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 调试模式
DEBUG=false

# WebSocket心跳间隔（秒）
WS_HEARTBEAT_INTERVAL=30

# 进化池配置
DISABLE_EVOLUTION_POOL=0

# SQL调试（设为1启用SQL日志）
DEBUG_SQL=0
