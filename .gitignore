*.py[cod]
*$py.class
*.egg-info/
/dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
# 注意：poetry.lock 已纳入版本控制以保证依赖可复现，故不在此忽略。

# ---- 测试 / 类型检查缓存 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

